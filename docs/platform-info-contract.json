{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Cognition-Partner-Workshops/uc-spring-boot-upgrade-microservice-extraction/docs/platform-info-contract.json",
  "title": "GET /platform/info response contract (DN-13)",
  "description": "Locked shared contract between backend (Subagent A) and frontend (Subagent B). Public endpoint (no JWT), 200 application/json. Envelope follows the existing convention of a single top-level key wrapping the payload (cf. {\"tags\": [...]} in TagsApi). runtime.* is read live at runtime; baseline.* comes from application.properties (platform.baseline.java-version, platform.baseline.spring-boot-version); endpoints is derived from RequestMappingHandlerMapping#getHandlerMethods(), filtered to controllers in package io.spring.api, sorted by path then method. The frontend must render whatever arrays it receives (no hard-coded endpoint or dependency lists).",
  "type": "object",
  "required": ["platform"],
  "additionalProperties": false,
  "properties": {
    "platform": {
      "type": "object",
      "required": ["runtime", "baseline", "dependencies", "endpoints", "summary"],
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "description": "Live values read from the running JVM / Spring context.",
          "type": "object",
          "required": ["javaVersion", "javaVendor", "springBootVersion", "springFrameworkVersion"],
          "additionalProperties": false,
          "properties": {
            "javaVersion": { "type": "string", "description": "System.getProperty(\"java.version\")", "examples": ["17.0.20"] },
            "javaVendor": { "type": "string", "description": "System.getProperty(\"java.vendor\")", "examples": ["Ubuntu"] },
            "springBootVersion": { "type": "string", "description": "org.springframework.boot.SpringBootVersion.getVersion()", "examples": ["3.3.5"] },
            "springFrameworkVersion": { "type": "string", "description": "org.springframework.core.SpringVersion.getVersion()", "examples": ["6.1.14"] }
          }
        },
        "baseline": {
          "description": "Pre-upgrade versions, configured in application.properties.",
          "type": "object",
          "required": ["javaVersion", "springBootVersion"],
          "additionalProperties": false,
          "properties": {
            "javaVersion": { "type": "string", "description": "platform.baseline.java-version", "examples": ["11"] },
            "springBootVersion": { "type": "string", "description": "platform.baseline.spring-boot-version", "examples": ["2.6.3"] }
          }
        },
        "dependencies": {
          "description": "Before -> after dependency upgrade table.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "from", "to"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "examples": ["Spring Boot", "Netflix DGS", "MyBatis Spring Boot", "jjwt", "Servlet / Validation API"] },
              "from": { "type": "string", "examples": ["2.6.3", "javax"] },
              "to": { "type": "string", "examples": ["3.3.5", "jakarta"] }
            }
          }
        },
        "endpoints": {
          "description": "Every REST endpoint served by controllers in io.spring.api, sorted by path then method.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["method", "path", "controller"],
            "additionalProperties": false,
            "properties": {
              "method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"] },
              "path": { "type": "string", "pattern": "^/", "examples": ["/articles", "/articles/{slug}/comments/{id}"] },
              "controller": { "type": "string", "description": "Simple class name of the @RestController", "examples": ["ArticlesApi", "UsersApi"] }
            }
          }
        },
        "summary": {
          "type": "object",
          "required": ["endpointCount", "upgradedDependencyCount"],
          "additionalProperties": false,
          "properties": {
            "endpointCount": { "type": "integer", "minimum": 0, "description": "Must equal endpoints.length" },
            "upgradedDependencyCount": { "type": "integer", "minimum": 0, "description": "Must equal dependencies.length" }
          }
        }
      }
    }
  },
  "examples": [
    {
      "platform": {
        "runtime": {
          "javaVersion": "17.0.20",
          "javaVendor": "Ubuntu",
          "springBootVersion": "3.3.5",
          "springFrameworkVersion": "6.1.14"
        },
        "baseline": { "javaVersion": "11", "springBootVersion": "2.6.3" },
        "dependencies": [
          { "name": "Spring Boot", "from": "2.6.3", "to": "3.3.5" },
          { "name": "Spring Framework", "from": "5.3.15", "to": "6.1.14" },
          { "name": "Java", "from": "11", "to": "17" },
          { "name": "Netflix DGS", "from": "4.9.21", "to": "8.7.1" },
          { "name": "MyBatis Spring Boot", "from": "2.2.2", "to": "3.0.3" },
          { "name": "jjwt", "from": "0.11.2", "to": "0.12.6" },
          { "name": "sqlite-jdbc", "from": "3.36.0.3", "to": "3.46.1.3" },
          { "name": "REST Assured (test)", "from": "4.5.1", "to": "5.5.0" },
          { "name": "Servlet / Validation API", "from": "javax", "to": "jakarta" }
        ],
        "endpoints": [
          { "method": "GET",    "path": "/articles",                      "controller": "ArticlesApi" },
          { "method": "POST",   "path": "/articles",                      "controller": "ArticlesApi" },
          { "method": "GET",    "path": "/articles/feed",                 "controller": "ArticlesApi" },
          { "method": "DELETE", "path": "/articles/{slug}",               "controller": "ArticleApi" },
          { "method": "GET",    "path": "/articles/{slug}",               "controller": "ArticleApi" },
          { "method": "PUT",    "path": "/articles/{slug}",               "controller": "ArticleApi" },
          { "method": "GET",    "path": "/articles/{slug}/comments",      "controller": "CommentsApi" },
          { "method": "POST",   "path": "/articles/{slug}/comments",      "controller": "CommentsApi" },
          { "method": "DELETE", "path": "/articles/{slug}/comments/{id}", "controller": "CommentsApi" },
          { "method": "DELETE", "path": "/articles/{slug}/favorite",      "controller": "ArticleFavoriteApi" },
          { "method": "POST",   "path": "/articles/{slug}/favorite",      "controller": "ArticleFavoriteApi" },
          { "method": "GET",    "path": "/platform/info",                 "controller": "PlatformInfoApi" },
          { "method": "GET",    "path": "/profiles/{username}",           "controller": "ProfileApi" },
          { "method": "DELETE", "path": "/profiles/{username}/follow",    "controller": "ProfileApi" },
          { "method": "POST",   "path": "/profiles/{username}/follow",    "controller": "ProfileApi" },
          { "method": "GET",    "path": "/tags",                          "controller": "TagsApi" },
          { "method": "GET",    "path": "/user",                          "controller": "CurrentUserApi" },
          { "method": "PUT",    "path": "/user",                          "controller": "CurrentUserApi" },
          { "method": "POST",   "path": "/users",                         "controller": "UsersApi" },
          { "method": "POST",   "path": "/users/login",                   "controller": "UsersApi" }
        ],
        "summary": { "endpointCount": 20, "upgradedDependencyCount": 9 }
      }
    }
  ]
}
