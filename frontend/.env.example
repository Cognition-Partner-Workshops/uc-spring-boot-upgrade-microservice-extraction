# Copy to .env.local (gitignored). NEXT_PUBLIC_* values are inlined at build time
# by Next.js, so restart `npm run dev` / re-run `npm run build` after changing them.

# When "true", /platform renders the fixture in lib/api/platformMock.ts instead of
# calling GET ${SERVER_BASE_URL}/platform/info. Leave unset (default) for the live endpoint.
NEXT_PUBLIC_PLATFORM_MOCK=false
